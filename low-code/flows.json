[
  {
    "id": "a1f0c0de00000001",
    "type": "tab",
    "label": "Smart Campus Room Checker",
    "disabled": false,
    "info": "Practice #12 - low-code track. Same contract and acceptance criteria (AC1-AC6) as the code-based track. No function (JavaScript) nodes: only inject, change, switch, debug and Dashboard 2.0 widgets; JSONata expressions are used only where plain operators are not enough."
  },
  {
    "id": "a1f0c0de00000002",
    "type": "inject",
    "z": "a1f0c0de00000001",
    "name": "On deploy",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 130,
    "y": 80,
    "wires": [["a1f0c0de00000003"]]
  },
  {
    "id": "a1f0c0de00000003",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "Set fictional bookings",
    "rules": [
      {
        "t": "set",
        "p": "bookings",
        "pt": "flow",
        "to": "[{\"id\":\"BK-1\",\"start\":\"2026-12-01T09:00\",\"end\":\"2026-12-01T10:30\",\"title\":\"Algorithms seminar\"},{\"id\":\"BK-2\",\"start\":\"2026-12-01T12:00\",\"end\":\"2026-12-01T13:00\",\"title\":\"Study group\"},{\"id\":\"BK-3\",\"start\":\"2026-12-01T15:00\",\"end\":\"2026-12-01T16:00\",\"title\":\"Club meeting\"}]",
        "tot": "json"
      },
      { "t": "set", "p": "payload", "pt": "msg", "to": "bookings", "tot": "flow" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 330,
    "y": 80,
    "wires": [["a1f0c0de00000004"]]
  },
  {
    "id": "a1f0c0de00000004",
    "type": "ui-table",
    "z": "a1f0c0de00000001",
    "group": "a1f0c0de000000b2",
    "name": "Bookings table",
    "label": "Bookings",
    "order": 1,
    "width": 0,
    "height": 0,
    "maxrows": 0,
    "passthru": false,
    "autocols": true,
    "showSearch": false,
    "deselect": true,
    "selectionType": "none",
    "columns": [],
    "mobileBreakpoint": "sm",
    "mobileBreakpointType": "defaults",
    "action": "replace",
    "className": "",
    "x": 540,
    "y": 80,
    "wires": [[]]
  },
  {
    "id": "a1f0c0de00000010",
    "type": "ui-form",
    "z": "a1f0c0de00000001",
    "name": "Slot form",
    "group": "a1f0c0de000000b1",
    "label": "",
    "order": 1,
    "width": 0,
    "height": 0,
    "options": [
      { "label": "Date", "key": "date", "type": "date", "required": true, "rows": null },
      { "label": "Start time", "key": "time", "type": "time", "required": true, "rows": null },
      { "label": "Duration (minutes, 1-120)", "key": "duration", "type": "number", "required": false, "rows": null },
      { "label": "Room is blocked (maintenance)", "key": "blocked", "type": "checkbox", "required": false, "rows": null }
    ],
    "formValue": { "date": "", "time": "", "duration": 60, "blocked": false },
    "payload": "",
    "submit": "Check availability",
    "cancel": "Clear",
    "resetOnSubmit": false,
    "topic": "topic",
    "topicType": "msg",
    "splitLayout": "",
    "className": "",
    "passthru": false,
    "dropdownOptions": [],
    "x": 110,
    "y": 200,
    "wires": [["a1f0c0de00000011"]]
  },
  {
    "id": "a1f0c0de00000011",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "Build request (expression)",
    "rules": [
      {
        "t": "set",
        "p": "req",
        "pt": "msg",
        "to": "{\n  \"start\": payload.date & \"T\" & $substring(payload.time, 0, 5),\n  \"duration\": $type(payload.duration) = \"number\" ? payload.duration :\n              ($type(payload.duration) = \"string\" and $contains($trim(payload.duration), /^-?\\d+(\\.\\d+)?$/)\n                 ? $number($trim(payload.duration)) : null),\n  \"blocked\": payload.blocked = true,\n  \"now\": $now(\"[Y0001]-[M01]-[D01]T[H01]:[m01]\", \"+0500\")\n}",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 300,
    "y": 200,
    "wires": [["a1f0c0de00000012"]]
  },
  {
    "id": "a1f0c0de00000012",
    "type": "switch",
    "z": "a1f0c0de00000001",
    "name": "Validate input (AC1, AC2, AC6)",
    "property": "req",
    "propertyType": "msg",
    "rules": [
      { "t": "jsonata_exp", "v": "$$.req.start <= $$.req.now", "vt": "jsonata" },
      { "t": "jsonata_exp", "v": "$type($$.req.duration) != \"number\" or $$.req.duration <= 0\nor $$.req.duration > 120 or $$.req.duration != $floor($$.req.duration)", "vt": "jsonata" },
      { "t": "else" }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 3,
    "x": 540,
    "y": 200,
    "wires": [["a1f0c0de00000020"], ["a1f0c0de00000021"], ["a1f0c0de00000013"]]
  },
  {
    "id": "a1f0c0de00000013",
    "type": "switch",
    "z": "a1f0c0de00000001",
    "name": "Room blocked? (AC4)",
    "property": "req.blocked",
    "propertyType": "msg",
    "rules": [{ "t": "true" }, { "t": "else" }],
    "checkall": "false",
    "repair": false,
    "outputs": 2,
    "x": 560,
    "y": 300,
    "wires": [["a1f0c0de00000022"], ["a1f0c0de00000014"]]
  },
  {
    "id": "a1f0c0de00000014",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "Find overlapping booking (AC3)",
    "rules": [
      {
        "t": "set",
        "p": "conflict",
        "pt": "msg",
        "to": "( $s := $toMillis($$.req.start & \":00Z\");  $e := $s + $$.req.duration * 60000;\n  $flowContext(\"bookings\")[$s < $toMillis(end & \":00Z\") and $e > $toMillis(start & \":00Z\")][0] )",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 590,
    "y": 380,
    "wires": [["a1f0c0de00000015"]]
  },
  {
    "id": "a1f0c0de00000015",
    "type": "switch",
    "z": "a1f0c0de00000001",
    "name": "Conflict found?",
    "property": "conflict",
    "propertyType": "msg",
    "rules": [{ "t": "nnull" }, { "t": "else" }],
    "checkall": "false",
    "repair": false,
    "outputs": 2,
    "x": 800,
    "y": 380,
    "wires": [["a1f0c0de00000023"], ["a1f0c0de00000024"]]
  },
  {
    "id": "a1f0c0de00000020",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "START_IN_PAST",
    "rules": [
      { "t": "set", "p": "result", "pt": "msg", "to": "{\"available\":false,\"reason\":\"START_IN_PAST\",\"message\":\"Input error: Start time must be in the future.\"}", "tot": "json" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 810,
    "y": 140,
    "wires": [["a1f0c0de00000030"]]
  },
  {
    "id": "a1f0c0de00000021",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "INVALID_DURATION",
    "rules": [
      { "t": "set", "p": "result", "pt": "msg", "to": "{\"available\":false,\"reason\":\"INVALID_DURATION\",\"message\":\"Input error: Duration must be a whole number of minutes from 1 to 120.\"}", "tot": "json" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 820,
    "y": 200,
    "wires": [["a1f0c0de00000030"]]
  },
  {
    "id": "a1f0c0de00000022",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "ROOM_BLOCKED",
    "rules": [
      { "t": "set", "p": "result", "pt": "msg", "to": "{\"available\":false,\"reason\":\"ROOM_BLOCKED\",\"message\":\"Unavailable: The room is blocked (e.g. maintenance).\"}", "tot": "json" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 810,
    "y": 280,
    "wires": [["a1f0c0de00000030"]]
  },
  {
    "id": "a1f0c0de00000023",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "OVERLAP (expression)",
    "rules": [
      {
        "t": "set",
        "p": "result",
        "pt": "msg",
        "to": "{\n  \"available\": false,\n  \"reason\": \"OVERLAP\",\n  \"message\": \"Unavailable: Overlaps existing booking \" & conflict.id & \" (\" &\n             $substring(conflict.start, 11, 5) & \"-\" & $substring(conflict.end, 11, 5) & \").\"\n}",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 1010,
    "y": 360,
    "wires": [["a1f0c0de00000030"]]
  },
  {
    "id": "a1f0c0de00000024",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "OK",
    "rules": [
      { "t": "set", "p": "result", "pt": "msg", "to": "{\"available\":true,\"reason\":\"OK\",\"message\":\"Available: The room is free for the selected interval.\"}", "tot": "json" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 990,
    "y": 420,
    "wires": [["a1f0c0de00000030"]]
  },
  {
    "id": "a1f0c0de00000030",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "Format decision (expression)",
    "rules": [
      { "t": "set", "p": "payload", "pt": "msg", "to": "result.message", "tot": "jsonata" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 1210,
    "y": 240,
    "wires": [["a1f0c0de00000031", "a1f0c0de00000032", "a1f0c0de00000034"]]
  },
  {
    "id": "a1f0c0de00000031",
    "type": "ui-text",
    "z": "a1f0c0de00000001",
    "group": "a1f0c0de000000b1",
    "order": 2,
    "width": 0,
    "height": 0,
    "name": "Decision",
    "label": "Decision",
    "format": "{{msg.payload}}",
    "layout": "col-center",
    "style": true,
    "font": "",
    "fontSize": "18",
    "color": "#203a6a",
    "wrapText": true,
    "className": "",
    "value": "payload",
    "valueType": "msg",
    "x": 1410,
    "y": 220,
    "wires": []
  },
  {
    "id": "a1f0c0de00000032",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "code -> payload",
    "rules": [
      { "t": "set", "p": "payload", "pt": "msg", "to": "\"available=\" & $string(result.available) & \" reason=\" & result.reason", "tot": "jsonata" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 1420,
    "y": 280,
    "wires": [["a1f0c0de00000033"]]
  },
  {
    "id": "a1f0c0de00000033",
    "type": "ui-text",
    "z": "a1f0c0de00000001",
    "group": "a1f0c0de000000b1",
    "order": 3,
    "width": 0,
    "height": 0,
    "name": "Reason code",
    "label": "Output contract",
    "format": "{{msg.payload}}",
    "layout": "row-left",
    "style": false,
    "font": "",
    "fontSize": 16,
    "color": "#717171",
    "wrapText": false,
    "className": "",
    "value": "payload",
    "valueType": "msg",
    "x": 1600,
    "y": 280,
    "wires": []
  },
  {
    "id": "a1f0c0de00000034",
    "type": "debug",
    "z": "a1f0c0de00000001",
    "name": "Result log",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "result",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 1420,
    "y": 330,
    "wires": []
  },
